/* t1 bootstrap - Tabelle1 dark, one orange accent, no chrome that isn't earning it. */

Screen {
    background: $background;
}

/* ---------- brand bar ---------- */

#brandbar {
    height: auto;
    padding: 1 3 0 3;
    background: $background;
}

#logo {
    width: auto;
    height: auto;
}

#tagline {
    width: 1fr;
    height: 100%;
    content-align: right bottom;
    color: $text-muted;
}

#brandrule {
    height: 1;
    margin: 0 3;
    color: $primary 40%;
}

/* ---------- body ---------- */

#body {
    height: 1fr;
    padding: 0 3;
}

#form {
    width: 100%;
    height: 100%;
    padding: 1 3 1 0;
    scrollbar-size-vertical: 1;
}

#side {
    width: 3fr;
    height: 100%;
    padding: 1 0 1 3;
    border-left: solid $panel;
}

/* ---------- fields ---------- */

.field {
    height: auto;
    margin-bottom: 1;
    padding-left: 2;
    border-left: blank;
}

/* The rail marks where you are without moving anything. */
.field:focus-within {
    border-left: outer $primary;
}

.field-head {
    height: 1;
    color: $text-muted;
    margin-bottom: 1;
}

.field-head-tight {
    height: 1;
    color: $text-muted;
}

Input {
    border: tall $panel;
    background: $surface;
    padding: 0 1;
    height: 3;
}

Input:focus {
    border: tall $primary;
    background: $surface;
}

Input.-invalid {
    border: tall $error 60%;
}

#problems {
    height: auto;
    color: $error;
    margin-top: 1;
    display: none;
}

#problems.visible {
    display: block;
}

#resolved {
    height: 1;
    color: $text-muted;
}

Select {
    border: none;
    height: 3;
    background: $surface;
}

Select > SelectCurrent {
    border: tall $panel;
    background: $surface;
    padding: 0 1;
}

Select:focus > SelectCurrent {
    border: tall $primary;
}

SelectOverlay {
    border: tall $primary;
    background: $surface;
}

RadioSet {
    border: none;
    background: transparent;
    height: auto;
    layout: horizontal;
    padding: 0;
}

RadioButton {
    border: none;
    background: transparent;
    padding: 0 3 0 0;
    width: auto;
}

RadioButton:focus,
Checkbox:focus {
    background: $boost;
    text-style: none;
}

RadioButton > .toggle--label,
Checkbox > .toggle--label {
    color: $foreground;
}

RadioButton.-on > .toggle--button,
Checkbox.-on > .toggle--button {
    color: $primary;
    background: $panel;
}

RadioButton > .toggle--button,
Checkbox > .toggle--button {
    color: $surface;
    background: $panel;
}

.choices {
    layout: grid;
    grid-size: 2;
    grid-rows: 1;
    grid-gutter: 0 2;
    height: auto;
}

Checkbox {
    border: none;
    background: transparent;
    padding: 0;
    height: 1;
    width: 100%;
}

/* ---------- create ---------- */

#create {
    width: 100%;
    margin-top: 1;
    border: none;
    height: 3;
    background: $primary;
    color: $background;
    text-style: bold;
}

#create:hover {
    background: $primary-lighten-1;
}

#create:focus {
    background: $primary-lighten-1;
    text-style: bold reverse;
}

#create:disabled {
    background: $panel;
    color: $text-disabled;
}

/* ---------- preview ---------- */

#side-head {
    height: 1;
    margin-bottom: 1;
}

#side-title {
    width: auto;
    color: $text-muted;
}

#counts {
    width: 1fr;
    margin-left: 2;
    text-align: right;
    color: $text-muted;
}

#tree-scroll {
    height: 1fr;
    scrollbar-size-vertical: 1;
}

#tree {
    height: auto;
}

#plan {
    height: auto;
    margin-top: 1;
    padding-top: 1;
    border-top: solid $panel;
    color: $text-muted;
}

/* ---------- hints ---------- */

#hints {
    dock: bottom;
    height: 1;
    padding: 0 3;
    background: $background;
    color: $text-muted;
}

/* ---------- build screen ---------- */

BuildScreen {
    background: $background;
}

#build-body {
    padding: 1 3;
    height: 1fr;
}

#build-log {
    height: 1fr;
    border: none;
    background: $background;
    scrollbar-size-vertical: 1;
}

#build-progress {
    height: 1;
    margin-bottom: 1;
}

#build-progress Bar > .bar--bar {
    color: $primary;
}

#build-progress Bar > .bar--complete {
    color: $success;
}

#outcome {
    height: auto;
    display: none;
    padding: 1 2;
    margin-top: 1;
    border: round $panel;
    background: $surface;
}

#outcome.visible {
    display: block;
}

/* ---------- what to do once it exists ---------- */

#actions {
    height: auto;
    margin-top: 1;
    display: none;
}

#actions.visible {
    display: block;
}

#actions Button {
    height: 3;
    border: none;
    text-style: bold;
}

#shell {
    width: 2fr;
    margin-right: 2;
    background: $primary;
    color: $background;
}

#shell:hover,
#shell:focus {
    background: $primary-lighten-1;
}

#done {
    width: 1fr;
    background: $panel;
    color: $foreground;
}

#done:hover,
#done:focus {
    background: $panel-lighten-2;
}

/* ---------- toggles: glyph carries the state, colour reinforces it ---------- */

Checkbox > .toggle--button,
RadioButton > .toggle--button {
    color: $text-muted;
    background: transparent;
}

Checkbox.-on > .toggle--button,
RadioButton.-on > .toggle--button {
    color: $primary;
    background: transparent;
}

.choices.narrow {
    grid-size: 1;
}

#left {
    width: 5fr;
    height: 100%;
}

#left #create {
    dock: bottom;
    margin: 1 3 0 0;
}

#build-progress Bar {
    width: 1fr;
}

#current {
    height: 1;
    color: $text-muted;
}

/* Single-line rows everywhere the content is a list, not prose. */

#tree,
#plan,
#counts,
.field-head,
.field-head-tight,
#resolved {
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

/* ---------- welcome ---------- */

WelcomeScreen {
    align: center middle;
    background: $background;
}

/* Exactly as wide as the wordmark, so everything lines up under it. */
#welcome {
    width: 63;
    max-width: 100%;
    height: auto;
}

#welcome-logo {
    width: 100%;
    height: auto;
    text-align: center;
}

#welcome-name,
#welcome-tagline,
#welcome-pitch,
#welcome-keys,
#welcome-credit {
    width: 100%;
    height: 1;
    text-align: center;
    text-wrap: nowrap;
    text-overflow: ellipsis;
}

#welcome-name {
    margin: 1 0;
}

#start {
    width: 100%;
    margin-top: 2;
    height: 3;
    border: none;
    background: $primary;
    color: $background;
    text-style: bold;
}

#start:hover {
    background: $primary-lighten-1;
}

#start:focus {
    background: $primary-lighten-1;
    text-style: bold reverse;
}

#welcome-keys {
    margin-top: 1;
}

#welcome-credit {
    dock: bottom;
    margin-bottom: 1;
}

/* ---------- uv prompt ---------- */

UvPrompt {
    align: center middle;
    background: $background 70%;
}

#uv-dialog {
    width: 68;
    height: auto;
    padding: 1 2;
    background: $panel;
    border: solid $primary;
}

#uv-title {
    height: 1;
    margin-bottom: 1;
}

#uv-why {
    height: auto;
}

#uv-command,
#uv-status {
    height: 1;
    margin-top: 1;
}

#uv-actions {
    height: auto;
    margin-top: 1;
}

#uv-actions Button {
    height: 3;
    border: none;
    text-style: bold;
}

#uv-yes {
    width: 1fr;
    margin-right: 2;
    background: $primary;
    color: $background;
}

#uv-yes:hover,
#uv-yes:focus {
    background: $primary-lighten-1;
}

#uv-no {
    width: 1fr;
    background: $panel;
    color: $text;
}

#uv-no:hover,
#uv-no:focus {
    background: $boost;
}
